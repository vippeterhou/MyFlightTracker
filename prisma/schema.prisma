generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TrackedFlight {
  id        String   @id @default(cuid())
  flightId  String
  date      DateTime
  label     String?
  createdAt DateTime @default(now())

  status FlightStatus?
}

model PollLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  level     String   // 'info' | 'warn' | 'error'
  flightId  String?
  message   String

  @@index([timestamp])
}

model FlightStatus {
  id              String        @id @default(cuid())
  trackedFlightId String        @unique
  trackedFlight   TrackedFlight @relation(fields: [trackedFlightId], references: [id], onDelete: Cascade)

  status           String
  departureAirport String?
  arrivalAirport   String?
  departureCity    String?
  arrivalCity      String?
  departureTz      String?
  arrivalTz        String?
  departureGate    String?
  arrivalGate      String?
  boardingAt       DateTime?
  scheduledDep     DateTime?
  estimatedDep     DateTime?
  actualDep        DateTime?
  wheelsOff        DateTime?
  wheelsOn         DateTime?
  scheduledArr     DateTime?
  estimatedArr     DateTime?
  actualArr        DateTime?
  aircraftType     String?
  baggageClaim     String?
  faFlightId       String?
  trackData        Json?

  statusChangedAt DateTime @default(now())
  lastChecked DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Single-row liveness stamp. The worker updates `lastRunAt` at the end of every
// poll cycle, even when no flight needed polling, so the UI can confirm the worker
// is alive on its interval rather than inferring it from the last PollLog (which
// is only written when there's something to report).
model WorkerHeartbeat {
  id        String   @id
  lastRunAt DateTime @default(now())
}

model ApiCall {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  endpoint   String
  flightId   String?
  durationMs Int
  success    Boolean
  httpStatus Int?

  @@index([timestamp])
  @@index([endpoint])
}

model TodoItem {
  id        String   @id @default(cuid())
  text      String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}
